# Public-client configuration only. Never place secrets in VITE_* variables.

# Optional Foundry Local override.
# Leave blank for the default Vite development proxy -> http://127.0.0.1:39839.
VITE_FOUNDRY_LOCAL_ENDPOINT=

# Optional read-only public-web gateway. This is an HTTPS endpoint, not a secret.
# Example: https://<function-host>/api/web
VITE_CROWNKEEP_WEB_GATEWAY_URL=

# Future RDC cloud configuration.
VITE_RDC_TENANT_ID=
VITE_RDC_CLIENT_ID=
VITE_RDC_API_BASE_URL=
VITE_RDC_API_SCOPE=
