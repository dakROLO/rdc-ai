{
  "name": "rdc-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run images:prepare && vite",
    "build": "npm run images:prepare && tsc -b && vite build",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "desktop:dev": "npm run desktop:prepare && tauri dev",
    "desktop:build": "npm run desktop:prepare && tauri build",
    "tauri": "tauri",
    "desktop:prepare": "tauri icon public/crownkeep-mark.svg",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:ui": "playwright test",
    "images:prepare": "node scripts/prepare-ocr.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.85.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
